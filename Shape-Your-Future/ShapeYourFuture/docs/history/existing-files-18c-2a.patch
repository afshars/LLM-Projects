+// ---------------- The PUT body (Part 18c-2a) ----------------
+
+/** What PUT /user-intelligence/habits gets: only the categories that changed, each holding only its changed keys. */
+export type HabitsPutBody = Partial<Record<HabitCategory, Record<string, unknown>>>;
+
+export interface HabitsPut {
+  /** At least one key would be sent. Drives the Save button. */
+  changed: boolean;
+  /** The draft differs from the loaded data in any way (even one that sends nothing, like a blank list row). Drives Discard. */
+  dirty: boolean;
+  body: HabitsPutBody;
+}
+
+/**
+ * Pure. A copy of the draft as it will be SENT: text trimmed, blank list rows dropped, a blank scalar left out. A value that
+ * is exactly what the server holds is never touched (so a saved "Run " is not "changed" to "Run"). A list that ends up
+ * empty is kept as `[]` only when the server holds that key (the whole list is replaced), otherwise the key goes away.
+ * Keys the form has no field for are copied as they are. Never mutates.
+ */
+export function normalizeHabitsDraft(draft: HabitProfileOut, original?: HabitProfileOut | null): HabitProfileOut {
+  const out: Record<string, unknown> = { ...(draft as unknown as Record<string, unknown>) };
+  for (const category of HABIT_CATEGORIES) {
+    const dict: Record<string, unknown> = { ...habitCategoryOf(draft, category) };
+    const saved = habitCategoryOf(original, category);
+    for (const field of HABIT_FIELDS[category]) {
+      if (!hasKey(dict, field.key)) continue;
+      const value = dict[field.key];
+      if (hasKey(saved, field.key) && deepEqual(value, saved[field.key])) continue; // untouched
+      if (field.kind === "list") {
+        if (!Array.isArray(value)) continue;
+        const items = value.filter((item): item is string => typeof item === "string").map((item) => item.trim()).filter((item) => item !== "");
+        if (items.length === 0 && !hasKey(saved, field.key)) delete dict[field.key];
+        else dict[field.key] = items;
+      } else if (typeof value === "string") {
+        const text = value.trim();
+        if (text === "") delete dict[field.key];
+        else dict[field.key] = text;
+      }
+    }
+    out[category] = dict;
+  }
+  return out as unknown as HabitProfileOut;
+}
+
+/**
+ * Pure. The request for the current draft. `diffForPartialPut` runs once per category on the normalized draft, so only
+ * changed KEYS are sent, each whole (a list is the full new list; shortening it or emptying it to `[]` is how an item or the
+ * list is removed). Never `null` (the diff skips it): the backend ignores a null category, merges a category with
+ * dict.update(), and would STORE a null value. A scalar the user emptied is not sent here: validateUiHabitsDraft already
+ * refuses it (`cleared`), the API has no way to remove it. Never `user_id`, never an unchanged category.
+ */
+export function computeHabitsPut(data: HabitProfileOut | null | undefined, draft: HabitProfileOut | null | undefined): HabitsPut {
+  if (!data || !draft) return { changed: false, dirty: false, body: {} };
+  const sent = normalizeHabitsDraft(draft, data);
+  const body: HabitsPutBody = {};
+  for (const category of HABIT_CATEGORIES) {
+    const diff = diffForPartialPut(habitCategoryOf(data, category), habitCategoryOf(sent, category));
+    if (diff.changed) body[category] = diff.body;
+  }
+  return { changed: Object.keys(body).length > 0, dirty: !deepEqual(data, draft), body };
+}
