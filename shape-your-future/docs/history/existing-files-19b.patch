--- a/frontend/src/style.css
+++ b/frontend/src/style.css
@@ -1415,6 +1415,185 @@
 }
 
 /* =========================================================================
+   Chat additions (Part 19b): stage badge, intent, side panel, ready/closed note.
+   Tokens only, logical properties only (mirrors under dir="rtl").
+   Layout: .chat-body is a grid with three children: feed, aside, dock.
+   Desktop: feed + dock on the start side, panel as a side column.
+   <= 900px: one column; the panel is a collapsible section between feed and dock.
+   ========================================================================= */
+
+.app-main:has(> .chat-view) { max-inline-size: var(--layout-wide-width); }
+
+.chat-body {
+  flex: 1;
+  min-block-size: 0;
+  min-inline-size: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, var(--sidebar-width));
+  grid-template-rows: minmax(0, 1fr) auto;
+  column-gap: var(--space-4);
+  row-gap: var(--space-2);
+}
+.chat-body > .chat-feed { grid-column: 1; grid-row: 1; min-inline-size: 0; }
+.chat-body > .chat-dock { grid-column: 1; grid-row: 2; min-inline-size: 0; }
+.chat-body > .chat-info { grid-column: 2; grid-row: 1 / span 2; }
+
+/* ---------------- Stage badge + intent ---------------- */
+
+.chat-meta {
+  flex: none;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-2) var(--space-3);
+  padding-inline: var(--space-2);
+  font-size: var(--text-xs);
+  color: var(--color-text-muted);
+}
+.chat-meta[hidden] { display: none; }
+
+.chat-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-1);
+  max-inline-size: 100%;
+  padding-block: var(--space-1);
+  padding-inline: var(--space-3);
+  border: 1px solid var(--color-border-strong);
+  border-radius: var(--radius-pill);
+  background: rgba(var(--color-accent-rgb), 0.08);
+  color: var(--color-text);
+  font-weight: var(--weight-medium);
+}
+.chat-badge__dot {
+  inline-size: var(--space-2);
+  block-size: var(--space-2);
+  border-radius: 50%;
+  background: var(--color-text-faint);
+  flex: none;
+}
+.chat-badge__label { color: var(--color-text-muted); font-weight: var(--weight-regular); }
+.chat-badge__value { overflow-wrap: anywhere; }
+.chat-badge--discovery .chat-badge__dot { background: var(--color-accent); }
+.chat-badge--ready { border-color: rgba(var(--color-success-rgb), 0.55); background: rgba(var(--color-success-rgb), 0.1); }
+.chat-badge--ready .chat-badge__dot { background: var(--color-success); }
+.chat-badge--closed { border-style: dashed; }
+
+.chat-intent { display: inline-flex; flex-wrap: wrap; gap: var(--space-1); min-inline-size: 0; }
+.chat-intent__value { color: var(--color-text); overflow-wrap: anywhere; }
+
+/* ---------------- Side panel: "What I know so far" ---------------- */
+
+.chat-info {
+  min-inline-size: 0;
+  min-block-size: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-lg);
+  background: var(--color-surface);
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+.chat-info__title { margin: 0; font-size: var(--text-md); font-weight: var(--weight-medium); }
+.chat-info__toggle { display: none; } /* narrow screens only */
+.chat-info__section { display: flex; flex-direction: column; gap: var(--space-2); margin-block-end: var(--space-4); }
+.chat-info__section:last-child { margin-block-end: 0; }
+.chat-info__heading {
+  margin: 0;
+  font-size: var(--text-sm);
+  font-weight: var(--weight-medium);
+  color: var(--color-text-muted);
+}
+.chat-info__topic { display: flex; flex-direction: column; gap: var(--space-1); }
+.chat-info__topic-title { margin: 0; font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-accent); }
+.chat-info__fields { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
+.chat-info__field { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
+.chat-info__field-label { font-size: var(--text-xs); color: var(--color-text-muted); }
+.chat-info__field-value { margin: 0; font-size: var(--text-sm); color: var(--color-text); overflow-wrap: anywhere; }
+.chat-info__missing { margin: 0; padding-inline-start: var(--space-5); font-size: var(--text-sm); color: var(--color-text); }
+.chat-info__missing li { overflow-wrap: anywhere; }
+.chat-info__empty { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }
+
+/* ---------------- Ready hint / closed notice (above the composer) ---------------- */
+
+.chat-stage-note {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-2);
+  padding-block: var(--space-2);
+  padding-inline: var(--space-3);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  color: var(--color-text-muted);
+  font-size: var(--text-sm);
+}
+.chat-stage-note[hidden] { display: none; }
+.chat-stage-note--ready { border-color: rgba(var(--color-success-rgb), 0.45); background: rgba(var(--color-success-rgb), 0.08); color: var(--color-text); }
+.chat-stage-note__text { margin: 0; overflow-wrap: anywhere; }
+
+.chat-composer__input:disabled { cursor: not-allowed; opacity: 0.7; }
+
+@media (max-width: 900px) {
+  .chat-body {
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: minmax(0, 1fr) auto auto;
+  }
+  .chat-body > .chat-feed { grid-column: 1; grid-row: 1; }
+  .chat-body > .chat-info { grid-column: 1; grid-row: 2; padding: 0; gap: 0; overflow: visible; }
+  .chat-body > .chat-dock { grid-column: 1; grid-row: 3; }
+
+  .chat-info__title { display: none; }
+  .chat-info__toggle {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-2);
+    inline-size: 100%;
+    min-block-size: var(--size-touch);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-4);
+    border: 0;
+    border-radius: var(--radius-lg);
+    background: transparent;
+    color: var(--color-text);
+    font: inherit;
+    font-size: var(--text-sm);
+    font-weight: var(--weight-medium);
+    text-align: start;
+    cursor: pointer;
+  }
+  .chat-info__toggle:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
+  .chat-info__chevron {
+    inline-size: var(--space-2);
+    block-size: var(--space-2);
+    border-inline-end: 2px solid currentColor;
+    border-block-end: 2px solid currentColor;
+    transform: rotate(45deg);
+    transition: transform var(--transition-fast);
+    flex: none;
+  }
+  .chat-info--open .chat-info__chevron { transform: rotate(-135deg); }
+
+  .chat-info__body { display: none; }
+  .chat-info--open .chat-info__body {
+    display: block;
+    max-block-size: 40dvh;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+    padding-block: 0 var(--space-4);
+    padding-inline: var(--space-4);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .chat-info__chevron { transition: none; }
+}
+
