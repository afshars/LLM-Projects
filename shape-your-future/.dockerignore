# Root-level ignore file. The compose build contexts are ./backend and ./frontend
# (each has its own .dockerignore); this one covers any build started from the repo root.
.env
.env.*
!.env.example
.git/
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
secrets/