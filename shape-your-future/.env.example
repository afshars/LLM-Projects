# Copy to `.env` (same folder as docker-compose.yml) and fill in: cp .env.example .env
# (Windows PowerShell: Copy-Item .env.example .env). `.env` is git-ignored and
# docker-ignored: never commit real values. Empty values fall back to the defaults in docker-compose.yml.

# --- App mode and signing key ---
# APP_ENV: development (default) or production. In production the backend REFUSES TO START unless SECRET_KEY is a
# random value of at least 32 characters that is not a dev/placeholder value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in development = a public dev default is used (a warning is logged). Never reuse it anywhere reachable.
APP_ENV=
SECRET_KEY=

# --- Host ports (change if 8010 / 3010 are taken or reserved, e.g. by Hyper-V/WinNAT on Windows) ---
BACKEND_PORT=
FRONTEND_PORT=
VITE_API_BASE_URL=

# --- LLM provider: openai | anthropic | groq | ollama | openai_compatible ---
LLM_PROVIDER=
LLM_MODEL_CHEAP=
LLM_TEMPERATURE=
LLM_BASE_URL=
# Required for openai_compatible. Keep the real key only in .env.
LLM_API_KEY=
# For LLM_PROVIDER=openai / anthropic / groq the key goes in OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY:
# uncomment the matching line in docker-compose.yml and add it here.

RATE_LIMIT_PER_MINUTE=
